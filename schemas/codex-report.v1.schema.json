{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/niconicotesla369/ai-dev-maintenance/schemas/codex-report.v1.schema.json",
  "title": "AIDM Codex Maintenance Report v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "toolVersion",
    "generatedAt",
    "command",
    "status",
    "redacted",
    "target",
    "findings",
    "metrics",
    "blockedReasons"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/definitions/reportStatus"
    },
    "redacted": {
      "const": true
    },
    "target": {
      "type": "object",
      "required": [
        "kind",
        "pathCategory"
      ],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "enum": [
            "default-codex-log-db",
            "unknown"
          ]
        },
        "pathCategory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findings": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "blockedReasons": {
      "$ref": "#/definitions/stringArray"
    },
    "nextSafeAction": {
      "type": "string"
    }
  },
  "definitions": {
    "reportStatus": {
      "enum": [
        "ok",
        "partial",
        "blocked",
        "unsupported",
        "error"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
