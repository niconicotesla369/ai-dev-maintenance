{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/niconicotesla369/ai-dev-maintenance/schemas/session-image-manifest.v1.schema.json",
  "title": "AIDM Private Session Image Manifest v1",
  "description": "Private append-only audit records. This schema intentionally excludes raw session content and image payloads.",
  "oneOf": [
    { "$ref": "#/definitions/runStart" },
    { "$ref": "#/definitions/filePrepared" },
    { "$ref": "#/definitions/fileSuccess" },
    { "$ref": "#/definitions/fileSkip" },
    { "$ref": "#/definitions/fileFailed" },
    { "$ref": "#/definitions/runSummary" }
  ],
  "definitions": {
    "planId": {
      "type": "string",
      "pattern": "^plan-[A-Za-z0-9][A-Za-z0-9-]{0,127}$"
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:(?:\\d{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12]\\d|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8])))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:00|0[48]|[2468][048]|[13579][26])00)-02-29))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "stableCode": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "verificationArray": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/stableCode" }
    },
    "runStart": {
      "type": "object",
      "required": [
        "schemaVersion",
        "recordType",
        "planId",
        "toolVersion",
        "algorithmVersion",
        "placeholderSha256",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "recordType": { "const": "run-start" },
        "planId": { "$ref": "#/definitions/planId" },
        "toolVersion": { "$ref": "#/definitions/toolVersion" },
        "algorithmVersion": { "const": "1.0" },
        "placeholderSha256": { "$ref": "#/definitions/hash" },
        "at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "filePrepared": {
      "$ref": "#/definitions/filePreparedRecord"
    },
    "filePreparedRecord": {
      "type": "object",
      "required": [
        "schemaVersion",
        "recordType",
        "planId",
        "toolVersion",
        "algorithmVersion",
        "placeholderSha256",
        "source",
        "pathCategory",
        "sourceBytes",
        "resultBytes",
        "occurrencesSeen",
        "imagesPrunable",
        "imagesStripped",
        "knownPlaceholders",
        "belowMinimum",
        "lines",
        "sourceSha256",
        "resultSha256",
        "verificationsPassed",
        "verificationsFailed",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "recordType": { "const": "file-prepared" },
        "planId": { "$ref": "#/definitions/planId" },
        "toolVersion": { "$ref": "#/definitions/toolVersion" },
        "algorithmVersion": { "const": "1.0" },
        "placeholderSha256": { "$ref": "#/definitions/hash" },
        "source": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\r\\n\\u0000]*$" },
        "pathCategory": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n\\u0000]+$" },
        "sourceBytes": { "$ref": "#/definitions/nonNegativeInteger" },
        "resultBytes": { "$ref": "#/definitions/nonNegativeInteger" },
        "occurrencesSeen": { "$ref": "#/definitions/nonNegativeInteger" },
        "imagesPrunable": { "$ref": "#/definitions/nonNegativeInteger" },
        "imagesStripped": { "$ref": "#/definitions/nonNegativeInteger" },
        "knownPlaceholders": { "$ref": "#/definitions/nonNegativeInteger" },
        "belowMinimum": { "$ref": "#/definitions/nonNegativeInteger" },
        "lines": { "$ref": "#/definitions/nonNegativeInteger" },
        "sourceSha256": { "$ref": "#/definitions/hash" },
        "resultSha256": { "$ref": "#/definitions/hash" },
        "verificationsPassed": { "$ref": "#/definitions/verificationArray" },
        "verificationsFailed": { "$ref": "#/definitions/verificationArray" },
        "at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "fileSuccess": {
      "type": "object",
      "required": [
        "schemaVersion",
        "recordType",
        "planId",
        "toolVersion",
        "algorithmVersion",
        "placeholderSha256",
        "source",
        "pathCategory",
        "sourceBytes",
        "resultBytes",
        "occurrencesSeen",
        "imagesPrunable",
        "imagesStripped",
        "knownPlaceholders",
        "belowMinimum",
        "lines",
        "sourceSha256",
        "resultSha256",
        "verificationsPassed",
        "verificationsFailed",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "recordType": { "const": "file-success" },
        "planId": { "$ref": "#/definitions/planId" },
        "toolVersion": { "$ref": "#/definitions/toolVersion" },
        "algorithmVersion": { "const": "1.0" },
        "placeholderSha256": { "$ref": "#/definitions/hash" },
        "source": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\r\\n\\u0000]*$" },
        "pathCategory": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n\\u0000]+$" },
        "sourceBytes": { "$ref": "#/definitions/nonNegativeInteger" },
        "resultBytes": { "$ref": "#/definitions/nonNegativeInteger" },
        "occurrencesSeen": { "$ref": "#/definitions/nonNegativeInteger" },
        "imagesPrunable": { "$ref": "#/definitions/nonNegativeInteger" },
        "imagesStripped": { "$ref": "#/definitions/nonNegativeInteger" },
        "knownPlaceholders": { "$ref": "#/definitions/nonNegativeInteger" },
        "belowMinimum": { "$ref": "#/definitions/nonNegativeInteger" },
        "lines": { "$ref": "#/definitions/nonNegativeInteger" },
        "sourceSha256": { "$ref": "#/definitions/hash" },
        "resultSha256": { "$ref": "#/definitions/hash" },
        "verificationsPassed": { "$ref": "#/definitions/verificationArray" },
        "verificationsFailed": { "$ref": "#/definitions/verificationArray" },
        "at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "fileSkip": {
      "type": "object",
      "required": [
        "schemaVersion",
        "recordType",
        "planId",
        "toolVersion",
        "algorithmVersion",
        "placeholderSha256",
        "source",
        "pathCategory",
        "verificationsPassed",
        "verificationsFailed",
        "reason",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "recordType": { "const": "file-skip" },
        "planId": { "$ref": "#/definitions/planId" },
        "toolVersion": { "$ref": "#/definitions/toolVersion" },
        "algorithmVersion": { "const": "1.0" },
        "placeholderSha256": { "$ref": "#/definitions/hash" },
        "source": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\r\\n\\u0000]*$" },
        "pathCategory": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n\\u0000]+$" },
        "sourceBytes": { "$ref": "#/definitions/nonNegativeInteger" },
        "resultBytes": { "$ref": "#/definitions/nonNegativeInteger" },
        "occurrencesSeen": { "$ref": "#/definitions/nonNegativeInteger" },
        "imagesPrunable": { "$ref": "#/definitions/nonNegativeInteger" },
        "imagesStripped": { "$ref": "#/definitions/nonNegativeInteger" },
        "knownPlaceholders": { "$ref": "#/definitions/nonNegativeInteger" },
        "belowMinimum": { "$ref": "#/definitions/nonNegativeInteger" },
        "lines": { "$ref": "#/definitions/nonNegativeInteger" },
        "sourceSha256": { "$ref": "#/definitions/hash" },
        "resultSha256": { "$ref": "#/definitions/hash" },
        "verificationsPassed": { "$ref": "#/definitions/verificationArray" },
        "verificationsFailed": { "$ref": "#/definitions/verificationArray" },
        "reason": { "enum": ["known-placeholder", "below-min-payload", "no-images", "no-prunable-images"] },
        "at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "fileFailed": {
      "type": "object",
      "required": [
        "schemaVersion",
        "recordType",
        "planId",
        "toolVersion",
        "algorithmVersion",
        "placeholderSha256",
        "source",
        "pathCategory",
        "verificationsPassed",
        "verificationsFailed",
        "code",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "recordType": { "const": "file-failed" },
        "planId": { "$ref": "#/definitions/planId" },
        "toolVersion": { "$ref": "#/definitions/toolVersion" },
        "algorithmVersion": { "const": "1.0" },
        "placeholderSha256": { "$ref": "#/definitions/hash" },
        "source": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[^\\r\\n\\u0000]*$" },
        "pathCategory": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n\\u0000]+$" },
        "sourceBytes": { "$ref": "#/definitions/nonNegativeInteger" },
        "resultBytes": { "$ref": "#/definitions/nonNegativeInteger" },
        "occurrencesSeen": { "$ref": "#/definitions/nonNegativeInteger" },
        "imagesPrunable": { "$ref": "#/definitions/nonNegativeInteger" },
        "imagesStripped": { "$ref": "#/definitions/nonNegativeInteger" },
        "knownPlaceholders": { "$ref": "#/definitions/nonNegativeInteger" },
        "belowMinimum": { "$ref": "#/definitions/nonNegativeInteger" },
        "lines": { "$ref": "#/definitions/nonNegativeInteger" },
        "sourceSha256": { "$ref": "#/definitions/hash" },
        "resultSha256": { "$ref": "#/definitions/hash" },
        "verificationsPassed": { "$ref": "#/definitions/verificationArray" },
        "verificationsFailed": { "$ref": "#/definitions/verificationArray" },
        "code": { "$ref": "#/definitions/stableCode" },
        "at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "runSummary": {
      "type": "object",
      "required": [
        "schemaVersion",
        "recordType",
        "planId",
        "status",
        "filesSucceeded",
        "filesSkipped",
        "filesFailed",
        "imagesStripped",
        "sourceBytes",
        "resultBytes",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "recordType": { "const": "run-summary" },
        "planId": { "$ref": "#/definitions/planId" },
        "status": { "enum": ["ok", "partial", "blocked"] },
        "filesSucceeded": { "$ref": "#/definitions/nonNegativeInteger" },
        "filesSkipped": { "$ref": "#/definitions/nonNegativeInteger" },
        "filesFailed": { "$ref": "#/definitions/nonNegativeInteger" },
        "imagesStripped": { "$ref": "#/definitions/nonNegativeInteger" },
        "sourceBytes": { "$ref": "#/definitions/nonNegativeInteger" },
        "resultBytes": { "$ref": "#/definitions/nonNegativeInteger" },
        "volumeFreeDeltaBytes": { "$ref": "#/definitions/safeInteger" },
        "at": { "$ref": "#/definitions/timestamp" }
      }
    }
  }
}
