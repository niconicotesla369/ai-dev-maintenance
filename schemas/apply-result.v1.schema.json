{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/niconicotesla369/ai-dev-maintenance/schemas/apply-result.v1.schema.json",
  "title": "AIDM Apply Result v1",
  "type": "object",
  "required": [
    "status",
    "planId",
    "applied",
    "blockedReasons",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "ok",
        "blocked"
      ]
    },
    "planId": {
      "type": "string",
      "pattern": "^plan-"
    },
    "action": {
      "enum": [
        "codex-fix",
        "cursor-clean"
      ]
    },
    "applied": {
      "type": "boolean"
    },
    "blockedReasons": {
      "$ref": "#/definitions/stringArray"
    },
    "warnings": {
      "$ref": "#/definitions/stringArray"
    },
    "result": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
