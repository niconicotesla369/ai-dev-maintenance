{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/niconicotesla369/ai-dev-maintenance/schemas/reclaim-run.v1.schema.json",
  "title": "AIDM Guided Reclaim Run v1",
  "description": "One record per approved guided reclaim run. All sizes are bytes; null means not measurable, never zero. deltaBytes is afterBytes - beforeBytes, so negative values are reductions. Totals count only ok and partial items. Volume change is an observation of the whole volume and is not attributed to AIDM.",
  "type": "object",
  "required": [
    "schemaVersion",
    "toolVersion",
    "command",
    "runId",
    "startedAt",
    "finishedAt",
    "status",
    "units",
    "items",
    "totals",
    "managedState",
    "volume"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "toolVersion": { "type": "string", "minLength": 1 },
    "command": { "const": "reclaim-run" },
    "runId": { "type": "string", "pattern": "^[0-9TZ-]+-[0-9a-f]{8}$" },
    "startedAt": { "type": "string", "minLength": 1 },
    "finishedAt": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ok", "partial", "blocked"] },
    "units": { "const": "bytes" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "outcome", "estimateBytes", "target", "reasons"],
        "additionalProperties": false,
        "properties": {
          "action": { "enum": ["codex-fix", "cursor-clean"] },
          "outcome": { "enum": ["ok", "partial", "blocked", "unknown"] },
          "estimateBytes": { "$ref": "#/definitions/nullableBytes" },
          "estimateNote": { "const": "wal-folds-into-database" },
          "target": { "$ref": "#/definitions/byteChange" },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["appliedItems", "excludedItems", "appliedTargetDeltaBytes"],
      "additionalProperties": false,
      "properties": {
        "appliedItems": { "type": "integer", "minimum": 0 },
        "excludedItems": { "type": "integer", "minimum": 0 },
        "appliedTargetDeltaBytes": { "$ref": "#/definitions/nullableDelta" }
      }
    },
    "managedState": { "$ref": "#/definitions/byteChange" },
    "volume": {
      "type": "object",
      "required": ["beforeBytes", "afterBytes", "deltaBytes", "attributedToAidm"],
      "additionalProperties": false,
      "properties": {
        "beforeBytes": { "$ref": "#/definitions/nullableBytes" },
        "afterBytes": { "$ref": "#/definitions/nullableBytes" },
        "deltaBytes": { "$ref": "#/definitions/nullableDelta" },
        "attributedToAidm": { "const": false }
      }
    }
  },
  "definitions": {
    "nullableBytes": {
      "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    },
    "nullableDelta": {
      "anyOf": [{ "type": "integer" }, { "type": "null" }]
    },
    "byteChange": {
      "type": "object",
      "required": ["beforeBytes", "afterBytes", "deltaBytes"],
      "additionalProperties": false,
      "properties": {
        "beforeBytes": { "$ref": "#/definitions/nullableBytes" },
        "afterBytes": { "$ref": "#/definitions/nullableBytes" },
        "deltaBytes": { "$ref": "#/definitions/nullableDelta" }
      }
    }
  }
}
