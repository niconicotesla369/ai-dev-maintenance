{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/niconicotesla369/ai-dev-maintenance/schemas/cursor-clean-result.v1.schema.json",
  "title": "AIDM Cursor Cleanup Result v1",
  "type": "object",
  "required": [
    "status",
    "mode",
    "reclaimableBytes",
    "deletedBytes",
    "deletedEntries",
    "targets",
    "blockedReasons",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "ready",
        "blocked",
        "ok",
        "partial"
      ]
    },
    "mode": {
      "enum": [
        "dry-run",
        "cleanup"
      ]
    },
    "reclaimableBytes": {
      "type": "number",
      "minimum": 0
    },
    "deletedBytes": {
      "type": "number",
      "minimum": 0
    },
    "deletedEntries": {
      "type": "number",
      "minimum": 0
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pathCategory",
          "bytes",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "pathCategory": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "number",
            "minimum": 0
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blockedReasons": {
      "$ref": "#/definitions/stringArray"
    },
    "warnings": {
      "$ref": "#/definitions/stringArray"
    }
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
