{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/niconicotesla369/ai-dev-maintenance/schemas/restore-validate-result.v1.schema.json",
  "title": "AIDM Restore Validation Result v1",
  "type": "object",
  "required": [
    "valid",
    "warnings"
  ],
  "additionalProperties": true,
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "inspection": {
      "type": "object",
      "additionalProperties": true
    },
    "reason": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
